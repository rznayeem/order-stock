{
  "version": 2,
  "functions": {
    "src/vercel-handler.ts": {
      "includeFiles": [
        "../../packages/database/package.json",
        "../../packages/database/src/**/*.ts",
        "../../packages/database/prisma/schema.prisma",
        "../../packages/database/generated/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "src/vercel-handler.ts"
    }
  ]
}
