{
  "version": 2,
  "builds": [
    {
      "src": "src/vercel-handler.ts",
      "use": "@vercel/node"
    }
  ],
  "functions": {
    "src/vercel-handler.ts": {
      "includeFiles": "../../packages/database/prisma/schema.prisma"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/vercel-handler.ts"
    }
  ]
}
