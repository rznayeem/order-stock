# ============================================
# Order-Stock Environment Variables
# ============================================
# Copy this to .env.local and fill in your values

# Database (Supabase PostgreSQL)
DATABASE_URL='your-supabase-pooler-connection-string'
DIRECT_URL='your-supabase-direct-connection-string'

# App
NODE_ENV="development"
SERVER_PORT="4000"

# Better Auth (server / API). Public URL of the Next.js app.
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="change-this-to-a-random-32-char-string"
# Optional: comma-separated extra origins for cookies/CORS (previews, extra domains)
# BETTER_AUTH_TRUSTED_ORIGINS="https://order-stock.vercel.app,http://localhost:3000"
# CORS_ORIGINS="https://order-stock.vercel.app,http://localhost:3000"

# Next.js (browser) — same URL as BETTER_AUTH_URL in production; required on Vercel for the web app
# NEXT_PUBLIC_BETTER_AUTH_URL="https://your-frontend.vercel.app"
# Optional: direct API URL for local dev only. Leave unset in production so the app uses same-origin /api/v1 → proxy (session cookies require this).
# NEXT_PUBLIC_API_URL="http://localhost:4000"

# Next.js server only: Express deployment URL for the /api/v1/* proxy (required for auth cookies when frontend and API are on different hosts)
# API_PROXY_TARGET="https://your-api.vercel.app"
